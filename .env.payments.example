# Keep false until real links, webhook delivery, SQL migration and test purchase pass.
PAYMENTS_ENABLED=false
STRIPE_MODE=test
STRIPE_WEBHOOK_SECRET=
# Payment Link IDs, not the public buy.stripe.com URL. Exact charged totals in cents.
# Example only; replace IDs and amounts with the links creator's verified values.
STRIPE_PAYMENT_LINK_MAP={}
DATABASE_URL=
BREVO_API_KEY=
BREVO_BUYER_LIST_ID=10
# Verified Brevo list IDs for each purchased package, in addition to the buyer exclusion list.
BREVO_PACKAGE_LIST_MAP={"digi":11,"printti":12,"premium":13,"joulu990":14}
ORDER_NOTIFY_EMAIL=info@thunderkustannus.fi
ORDER_SENDER_EMAIL=info@thunderkustannus.fi
# Confirmed: contact within one business day.
ORDER_RESPONSE_WINDOW=business-day

# Public URLs only. No secret keys belong in VITE_* variables.
VITE_STRIPE_DIGI_PAYMENT_LINK=
VITE_STRIPE_PRINTTI_PAYMENT_LINK=
VITE_STRIPE_PREMIUM_PAYMENT_LINK=
# Separate format cards: fill only if these are distinct verified products.
VITE_STRIPE_PRINTED_PAYMENT_LINK=
VITE_STRIPE_AUDIO_PAYMENT_LINK=
VITE_STRIPE_EBOOK_PAYMENT_LINK=
# Optional override: a verified public link is already stored in shared/payment-links.ts.
# VITE_STRIPE_JOULU990_PAYMENT_LINK=https://buy.stripe.com/00w4gz4px0SV4kz7KH8g000
# Klarna confirmed on Printti and the campaign. Set false to hide the general note.
VITE_KLARNA_ENABLED=true

